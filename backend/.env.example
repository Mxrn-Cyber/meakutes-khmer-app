# MySQL connection
# Cloud MySQL (Aiven, TiDB Cloud, ...) needs SSL, e.g.
# mysql+pymysql://USER:PASS@HOST:PORT/DB?ssl_ca=/etc/ssl/certs/ca-certificates.crt
DATABASE_URL=mysql+pymysql://meakutes:changeme@localhost:3306/meakutes_khmer

# Session/JWT signing
SECRET_KEY=change-this-to-a-random-64-char-string
SESSION_COOKIE_NAME=mk_session
SESSION_EXPIRE_MINUTES=43200
# Set COOKIE_SECURE=true in production (HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google OAuth (Web Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend origin(s) allowed to call this API, comma-separated
CORS_ORIGINS=http://localhost:5173

# Where uploaded media is stored on disk and served from
MEDIA_ROOT=./media
MEDIA_URL_PREFIX=/media
