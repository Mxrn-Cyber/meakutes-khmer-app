# MySQL connection
# Cloud MySQL (Aiven, TiDB Cloud, ...) needs SSL, e.g.
# mysql+pymysql://USER:PASS@HOST:PORT/DB?ssl_ca=/etc/ssl/certs/ca-certificates.crt
DATABASE_URL=mysql+pymysql://meakutes:changeme@localhost:3306/meakutes_khmer

# Session/JWT signing
SECRET_KEY=change-this-to-a-random-64-char-string
SESSION_COOKIE_NAME=mk_session
SESSION_EXPIRE_MINUTES=43200
# Set COOKIE_SECURE=true in production (HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google OAuth (Web Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend origin(s) allowed to call this API, comma-separated
CORS_ORIGINS=http://localhost:5173

# Where uploaded media is stored on disk and served from
MEDIA_ROOT=./media
MEDIA_URL_PREFIX=/media

# Image storage: "local" (development) or "r2" (production, Cloudflare R2)
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=meakutes-khmer-media
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Account emails (confirm address, reset password).
# Gmail: turn on 2-Step Verification, then create an App Password.
# Leave SMTP_HOST empty to print the links in the server log instead.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Meakutes-Khmer <you@gmail.com>
